# Copy to .env.worker (git-ignored) and fill in.
# Backend origin (the FastAPI service, not the Next.js site), without /api/v1.
KOLVEX_API_URL=https://your-backend.example.com
# Same value as YOUTUBE_IMPORT_WORKER_TOKEN on the backend.
KOLVEX_WORKER_TOKEN=
# Optional: when YouTube says "Sign in to confirm you're not a bot", use a signed-in browser's cookies.
# chrome / safari / firefox / edge / brave. macOS may ask for Keychain access (Chrome) or Full Disk Access (Safari).
# YTDLP_COOKIES_FROM_BROWSER=chrome

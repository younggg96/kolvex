# Copy to .env.worker (git-ignored) and fill in.
# Backend origin (the FastAPI service, not the Next.js site), without /api/v1.
KOLVEX_API_URL=https://your-backend.example.com
# Same value as FEAR_GREED_WORKER_TOKEN on the backend.
KOLVEX_WORKER_TOKEN=
# Browser: chrome = installed Google Chrome (default); leave empty for Playwright's Chromium.
# FEAR_GREED_BROWSER_CHANNEL=chrome
# Set to false to show the browser window when CNN blocks headless mode.
# FEAR_GREED_HEADLESS=true

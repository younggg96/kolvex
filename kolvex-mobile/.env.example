# Include /api/v1. Leave empty to use clearly labeled demo quotes.
# Physical iPhone: use the LAN IP of the machine running FastAPI.
# Use HTTPS for deployed APIs; never put service keys in EXPO_PUBLIC variables.
EXPO_PUBLIC_API_URL=
# The same project as the website. Publishable or legacy anon key only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional HTTPS website origin for password recovery.
EXPO_PUBLIC_WEB_URL=

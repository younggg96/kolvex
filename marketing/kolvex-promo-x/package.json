{
  "name": "kolvex-promo-x",
  "version": "1.0.0",
  "private": true,
  "description": "Kolvex 25s promo for X — Remotion project built with video-shotcraft (autonomous free creation)",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "capture": "node scripts/capture.mjs",
    "render": "remotion render src/index.ts KolvexPromo out/kolvex-promo.mp4",
    "render:nobgm": "remotion render src/index.ts KolvexPromo out/kolvex-promo-nobgm.mp4 --props=props-nobgm.json",
    "still": "remotion still src/index.ts KolvexPromo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "@remotion/google-fonts": "4.0.484",
    "@remotion/motion-blur": "4.0.484",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.484"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "puppeteer": "^24.0.0",
    "typescript": "6.0.3"
  }
}

# 应用配置
APP_NAME=Kolvex API
APP_VERSION=1.0.0
DEBUG=True
API_VERSION=v1

# 数据库配置
POSTGRES_USER=kolvex
POSTGRES_PASSWORD=kolvex123
POSTGRES_DB=kolvex
DATABASE_URL=postgresql://kolvex:kolvex123@localhost:5432/kolvex
ROBINHOOD_DATABASE_URL=sqlite:///robinhood_sync.db

# JWT 配置
SECRET_KEY=your-secret-key-change-this-in-production-please-use-a-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS 配置
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Finnhub API (必需 - 实时股票数据)
# 免费注册: https://finnhub.io
FINNHUB_API_KEY=your-finnhub-api-key

# Robinhood Sync (可选 - 本地 SQLite 缓存)
ROBINHOOD_USERNAME=your_email@example.com
ROBINHOOD_PASSWORD=your_password
# 如果开启了 2FA，请填写 Authenticator App 的 TOTP secret，不是 6 位验证码
ROBINHOOD_TOTP_SECRET=your_totp_secret_key

# OpenAI API (可选 - 用于 AI 智能分析)
OPENAI_API_KEY=sk-xxxx

# Twilio (可选 - WhatsApp 通知)
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=+14155238886

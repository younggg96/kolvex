# Use a backend origin (not the Next.js frontend URL). Remote backends require HTTPS.
KOLVEX_API_URL=http://127.0.0.1:8080
# A signed-in Kolvex administrator's access_token, NOT anon/service_role/API keys.
# When the session expires, replace the token and restart the MCP process.
KOLVEX_ADMIN_ACCESS_TOKEN=

# Required only for streamable-http; separate from the backend token.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
KOLVEX_MCP_AUTH_TOKEN=
# Explicit HTTP Host allowlist; add your deployed hostname when serving remotely.
# On Railway, RAILWAY_PUBLIC_DOMAIN is also automatically allowed.
KOLVEX_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
# Browser Origin allowlist, only when using a browser-based MCP client.
KOLVEX_MCP_ALLOWED_ORIGINS=
